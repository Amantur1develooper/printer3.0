# ── Security ─────────────────────────────────────────────────────────
SECRET_KEY=замените-на-длинный-случайный-ключ-минимум-50-символов
DEBUG=False

# ── Hosts ─────────────────────────────────────────────────────────────
# Добавьте IP сервера и домен через запятую (без пробелов)
ALLOWED_HOSTS=127.0.0.1,ВАШ_IP,ваш-домен.com

# ── Database (postgres для продакшна) ────────────────────────────────
DB_ENGINE=postgres
DB_NAME=onlineprinter
DB_USER=printer
DB_PASSWORD=придумайте-надёжный-пароль
DB_HOST=db
DB_PORT=5432

# ── Payment ──────────────────────────────────────────────────────────
PAYMENT_PHONE=+996 700 123456
PAYMENT_RECIPIENT=Имя Фамилия

# ── Limits ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MIN_PAPER_THRESHOLD=5
