SECRET_KEY=dev-local-secret-key-not-for-production-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,onlineprinter.kg,www.onlineprinter.kg

# sqlite — для локальной разработки
DB_ENGINE=sqlite

# Телефон для оплаты (показывается в QR-коде и на странице оплаты)
PAYMENT_PHONE=+996 700 123456
PAYMENT_RECIPIENT=Имя Фамилия

# Максимальный размер файла в МБ
MAX_FILE_SIZE_MB=50

# Минимальный порог бумаги (если меньше — заказ не принимается)
MIN_PAPER_THRESHOLD=5
